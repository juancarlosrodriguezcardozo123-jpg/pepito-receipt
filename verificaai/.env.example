# ── Básico ───────────────────────────────────────────────
DATABASE_URL="postgresql://verificaai:verificaai@localhost:5432/verificaai"
APP_URL="http://localhost:3000"
# Nombre de marca visible (no es secreto)
NEXT_PUBLIC_APP_NAME="VerificaAI"

# ── Almacenamiento privado de documentos ─────────────────
# Carpeta fuera de /public. Los archivos se cifran con AES-256-GCM.
STORAGE_DIR="./storage"
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_ENCRYPTION_KEY=""

# ── Límites ──────────────────────────────────────────────
MAX_UPLOAD_MB=10
MAX_EXTRACTED_CHARS=300000
MAX_PDF_PAGES=300
# Días que se conservan los documentos antes de la purga automática (0 = sin purga)
RETENTION_DAYS=180
# Secreto para invocar la purga de retención: POST /api/cron/retention con cabecera Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── Correo (recuperación de contraseña) ──────────────────
# Si no se configura, en desarrollo el enlace se imprime en la consola del servidor.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="VerificaAI <no-reply@example.com>"

# ── Detector de IA externo (opcional) ────────────────────
# "none" o "http". Ver README → "Contrato del detector de IA".
AI_DETECTOR_PROVIDER="none"
AI_DETECTOR_NAME=""
AI_DETECTOR_API_URL=""
AI_DETECTOR_API_KEY=""

# ── Búsqueda de fuentes externas (opcional) ──────────────
# "none" o "http". Ver README → "Contrato del proveedor de búsqueda".
SEARCH_PROVIDER="none"
SEARCH_PROVIDER_NAME=""
SEARCH_API_URL=""
SEARCH_API_KEY=""
